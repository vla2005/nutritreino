# Copie para .env.docker e use: docker compose --env-file .env.docker up -d --build
WEB_PORT=8080
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

DOCKER_DB_DATABASE=nutritreino
DOCKER_DB_USERNAME=nutritreino
DOCKER_DB_PASSWORD=troque-esta-senha
MYSQL_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=100

# Se vazio, uma chave segura e persistente sera criada no volume api_storage.
APP_KEY=
LOG_LEVEL=warning

CORS_ALLOWED_ORIGINS=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

# Pusher e necessario apenas para chat/video em tempo real.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Por padrao, emails vao para os logs. Configure SMTP em producao.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME=NutriTreino

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
